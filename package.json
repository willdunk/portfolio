{
  "name": "portfolio",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@chakra-ui/react": "~2.8.2",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@types/node": "^16.18.126",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "axios": "^1.21.1",
    "chakra-ui-markdown-renderer": "^4.1.0",
    "framer-motion": "^10.18.0",
    "lodash": "^4.18.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-icons": "^4.12.0",
    "react-markdown": "^8.0.7",
    "react-router-dom": "^7.18.5",
    "typescript": "^4.9.5"
  },
  "scripts": {
    "start": "cross-env PORT=3000 parcel index.html",
    "build": "rm -rf dist && parcel build index.html",
    "lint": "eslint . --ext .ts,.tsx,.mdx",
    "lint-and-fix": "eslint . --ext .ts,.tsx,.mdx --fix"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all",
      "not and_uc > 0"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@mdx-js/react": "^1.6.22",
    "@parcel/transformer-image": "^2.16.4",
    "@parcel/transformer-mdx": "^2.13.3",
    "@shopify/eslint-plugin": "^43.0.0",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "buffer": "^6.0.3",
    "cross-env": "^10.1.0",
    "eslint": "^8.57.1",
    "eslint-plugin-mdx": "^2.3.4",
    "parcel": "^2.16.4",
    "prettier": "^3.10.1",
    "process": "^0.11.10"
  },
  "parcel": {
    "transformers": {
      "*.png": [
        "parcel-transformer-image"
      ],
      "*.jpg": [
        "parcel-transformer-image"
      ]
    }
  },
  "resolutions": {
    "**/@typescript-eslint/typescript-estree/minimatch": "^11.0.1",
    "**/@npmcli/map-workspaces/minimatch": "^11.0.1",
    "**/@mdx-js/mdx/@babel/core": "^7.29.6",
    "**/remark-mdx/@babel/core": "^7.29.6",
    "**/remark-parse/trim": "^0.0.3",
    "**/@npmcli/map-workspaces/glob": "^14.0.6"
  },
  "@parcel/resolver-default": {
    "packageExports": true
  }
}
